# Copy to .env and adjust as needed - every value here matches the
# documented default in app/helper/config.py.

# --- Provider identity ------------------------------------------------
# Must start with "tv.plex.agents.custom." and be globally unique - see
# app/helper/config.py's comment on PROVIDER_IDENTIFIER.
PROVIDER_IDENTIFIER=tv.plex.agents.custom.yourname.template
PROVIDER_TITLE=Media Provider Template
PROVIDER_VERSION=1.0.0
PROVIDER_USER_AGENT=MediaProviderTemplate/1.0

# --- Metadata sources: enable per category, choose which sources -------
# ENABLE_<CATEGORY>_SOURCES: category on/off.
# <CATEGORY>_SOURCES: comma-separated, priority-ordered source module names.
# See app/client/registry.py.
ENABLE_MOVIE_SOURCES=true
MOVIE_SOURCES=example_movie

ENABLE_SHOW_SOURCES=false
SHOW_SOURCES=example_show

# No source for season/episode - see
# app/client/source/season/__init__.py and .../episode/__init__.py.
ENABLE_SEASON_SOURCES=false
SEASON_SOURCES=

ENABLE_EPISODE_SOURCES=false
EPISODE_SOURCES=

# Off by default - see app/client/source/music/example_music.py.
ENABLE_MUSIC_SOURCES=false
MUSIC_SOURCES=example_music

# --- Matching/scoring thresholds (0-100) --------------------------------
EXACT_IGNORE_SCORE=85
MANUAL_IGNORE_SCORE=65

# --- Misc ----------------------------------------------------------------
INCLUDE_EXTRA_IN_SUMMARY=true
DEFAULT_PAGE_SIZE=20

# --- Caches ----------------------------------------------------------------
ENTRY_CACHE_TTL_SECONDS=60
ENTRY_CACHE_MAX_SIZE=2000
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_CACHE_MAX_SIZE=500

# --- Server ----------------------------------------------------------------
PORT=32900
DEBUG=false
LOG_LEVEL=INFO
